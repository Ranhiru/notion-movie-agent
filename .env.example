# Notion Movie/TV Enrichment Agent — environment template.
# Copy to .env and fill in. .env is gitignored; never commit real secrets.
# Keys per RESEARCH §10. The Phase 0 spikes load this file via python-dotenv.
#
# NOTE: keep comments on their OWN lines. python-dotenv treats text after `=` as the
# value verbatim (it does NOT strip inline `# ...` comments), so `KEY=  # note` would
# set KEY to "# note" — a non-empty garbage value. Leave unset keys as bare `KEY=`.

# --- Notion (data model §8) ---
# Integration scoped to the Watchlist data source only (least privilege).
NOTION_MOVIE_DB_TOKEN=
# Watchlist data source id (2025-09-03 API). Pre-filled — not a secret.
NOTION_WATCHLIST_DATA_SOURCE_ID=ffcdcd68-0449-461d-be8e-0af9b71f9d5f

# --- OMDb (metadata lane) ---
OMDB_API_KEY=

# --- RT resolution providers (chain; Firecrawl primary, rest are Phase 8) ---
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
PERPLEXITY_API_KEY=

# --- LLM endpoint (OpenAI-compatible: local LLM in dev, or OpenRouter) — ADR 0011 ---
# e.g. http://localhost:8888/v1  (local)  or  https://openrouter.ai/api/v1
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Three role models. Each MUST support tool-calling / structured outputs.
OPENAI_EXTRACTION_MODEL=
OPENAI_DISAMBIGUATION_MODEL=
OPENAI_JUDGE_MODEL=
# Per-request output cap for all three roles. Reasoning models (e.g. gemma-4-12B) can emit
# unbounded <think> tokens on a big extraction prompt and never return — a hung sweep. Bound
# it (e.g. 8192) to guarantee each call terminates. 0 / unset = let the server decide.
OPENAI_MAX_TOKENS=8192

# --- Slack HITL transport (Socket Mode) — ADR 0010 ---
# bot token starts xoxb- ; app token starts xapp- (needs scope connections:write)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL=#notion-movie-db

# --- Durable checkpointer (ADR 0006 / 0007 — Phase 6) ---
# AsyncSqliteSaver file (thread_id = page_id). Must be persistent so a paused HITL run
# survives a restart → a named volume in the Phase 10 Docker deploy. Gitignored (*.sqlite).
CHECKPOINT_DB_PATH=checkpoints.sqlite
# Phase 6d: how long an awaiting_input row may sit before the cron auto-resolves it with the
# pre-filter's best guess (confidence: low). Default 7 days; shorten to test the path.
STALE_INTERRUPT_TIMEOUT_SECONDS=604800

# --- LangSmith tracing (ON from Phase 1) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
LANGSMITH_PROJECT=NotionMovieDBAgent

# --- Search provider chain order (Phase 8) ---
SEARCH_PROVIDERS=firecrawl,tavily,exa,perplexity
